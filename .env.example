# Frani Receipt Book — configuration
# Copy to .env and adjust. All values default to testnet2.

# Network. Must be testnet2. Do not point this at mainnet.
RECEIPTS_NETWORK=testnet2

# Where the wallet keys and state live on disk.
RECEIPTS_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
RECEIPTS_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret).
RECEIPTS_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
RECEIPTS_DEVICE_ID=frani-receipts-1

# Optional @nametag to register on first run (leave blank to skip).
RECEIPTS_NAMETAG=

# Where receipts are stored.
RECEIPTS_DIR=./receipts

# Set to 1 to auto-record a signed receipt for every confirmed incoming payment.
RECEIPTS_AUTO_RECORD=0
