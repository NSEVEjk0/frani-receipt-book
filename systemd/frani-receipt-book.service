[Unit]
Description=Frani Receipt Book — signed receipt archive on Unicity testnet2
Documentation=https://github.com/NSEVEjk0/frani-receipt-book
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/frani-receipt-book
EnvironmentFile=-/home/ubuntu/projects/frani-receipt-book/.env
ExecStart=/usr/bin/node bin/receipts.js daemon
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
